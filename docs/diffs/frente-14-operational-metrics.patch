+  assert.match(s, /^\d{4}-\d{2}-\d{2}T00:00:00/);
+  // Offset 0 vs -1 difere em 24h
+  const a = new Date(startOfUtcDay(0)).getTime();
+  const b = new Date(startOfUtcDay(-1)).getTime();
+  assert.equal(a - b, 86400000);
+});
