# Dependências
node_modules/

# Segredos e ambiente
.env

# Dados de runtime (banco SQLite e workspaces das conversas)
data/
workspaces/

# Build do frontend (gerado por `npm run build`; estava versionado por engano —
# aparecia em toda busca no repositório e divergia da fonte a cada alteração)
frontend/dist/

# Logs e temporários
*.log
npm-debug.log*
.DS_Store
__pycache__/

# Artefatos gerados ao rodar os testes (workspaces temporários)
.test-workspaces/
backend/.test-workspaces/

# Testes ponta a ponta (e2e/): relatórios, rastros, vídeos e os diretórios
# descartáveis que o backend de E2E usa como workspace/DATA_DIR.
test-results/
playwright-report/
e2e/.tmp/

# Launcher compilado (gerado por build)
launcher/*.exe
frederico-launcher
Frederico AI Studio.exe
