{
  "name": "frederico-ai-studio-backend",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node -e \"import('./src/migrate.js').then(m=>m.runMigrations()).then(()=>process.exit(0)).catch(e=>{console.error(e);process.exit(1)})\"",
    "lint": "node scripts/lint.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "node scripts/run-tests.mjs",
    "test:integration": "node scripts/check-migrations.mjs && node --test 'src/**/*.test.js'",
    "test:all": "npm run lint && npm run test:integration",
    "test:count": "node scripts/count-tests.mjs",
    "check": "npm run lint && npm test",
    "audit:models": "node scripts/audit-model-catalog.mjs"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "better-auth": "^1.6.23",
    "cors": "^2.8.5",
    "dockerode": "^4.0.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "nanoid": "^5.0.9",
    "openai": "^4.78.1",
    "pg": "^8.13.1",
    "puppeteer-core": "^23.11.1",
    "zod": "^3.25.76"
  }
}
