DEEPSEEK_API_KEY=coloque_sua_chave_aqui
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
PORT=3001
FRONTEND_URL=http://localhost:5173
SANDBOX_IMAGE=frederico-ai-sandbox:latest
SANDBOX_MEMORY=1024m
SANDBOX_CPUS=1
TOOL_TIMEOUT_MS=45000

# Rodando via docker compose, estas duas são definidas no compose e podem
# ficar como estão. Rodando o backend direto no host (npm run dev),
# ambas devem apontar para o MESMO diretório local:
WORKSPACE_ROOT=./workspaces
# HOST_WORKSPACE_ROOT=/caminho/absoluto/para/workspaces
DB_PATH=./data/app.sqlite
