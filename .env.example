DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# OpenRouter: deixe sem definir para o roteador priorizar a confiabilidade de
# ferramentas. Use "throughput", "latency" ou "price" somente se quiser
# substituir conscientemente a selecao automatica do provedor.
# OPENROUTER_PROVIDER_SORT=
# Identificação do app no OpenRouter (Registros/Activity e rankings). Sem isso,
# as chamadas chegam sem identificação e o app aparece como "desconhecido".
# OPENROUTER_APP_TITLE = nome exibido; OPENROUTER_APP_URL = URL do app/site.
# Se não definir a URL, cai para FRONTEND_URL / BETTER_AUTH_URL automaticamente.
OPENROUTER_APP_TITLE=Frederico IA Studio
# OPENROUTER_APP_URL=https://SEU_DOMINIO
PORT=3001
FRONTEND_URL=http://localhost:5173
SANDBOX_IMAGE=frederico-ai-sandbox:latest

# ---- Autenticação / Login (Better Auth — e-mail/senha + GitHub + Google) ----
# Origem pública do app (dev = localhost:5173; em produção, https://SEU_DOMINIO).
# É a base dos callbacks OAuth registrados no GitHub/Google.
# No celular via Tailscale Serve, troque pelo HTTPS mostrado por
# `tailscale serve status` (ex.: https://seu-pc.sua-rede.ts.net).
# Use essa mesma origem nos callbacks OAuth do GitHub e do Google.
BETTER_AUTH_URL=http://localhost:5173
# Segredos gerados com `openssl rand -hex 32` (um valor cada, NÃO reutilizar):
BETTER_AUTH_SECRET=cole_aqui_o_1o_openssl_rand_hex_32
ENCRYPTION_KEY=cole_aqui_o_2o_openssl_rand_hex_32
# Credenciais OAuth (crie em github.com/settings/developers e console.cloud.google.com)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# CONECTOR GitHub em 1 clique (Configurações → Conectores → "Conectar com
# GitHub"): crie um SEGUNDO OAuth App em github.com/settings/developers
# (o do login não serve — o GitHub só aceita um callback por app) com:
#   Homepage URL:               <BETTER_AUTH_URL>
#   Authorization callback URL: <BETTER_AUTH_URL>/api/connectors/github/callback
# Sem estas credenciais, o conector continua funcionando por token colado.
GITHUB_CONNECTOR_CLIENT_ID=
GITHUB_CONNECTOR_CLIENT_SECRET=
# Memória do sandbox. Com LibreOffice/OCR, 2 GB evita travas em arquivos
# grandes. Reduza se o notebook tiver pouca RAM (mínimo prático ~1024m).
SANDBOX_MEMORY=2048m
SANDBOX_CPUS=1
TOOL_TIMEOUT_MS=45000
# Etapas (turnos do modelo / chamadas de ferramenta) do loop do agente.
# AGENT_MAX_STEPS é PISO, não teto: nunca reduz o esforço escolhido no menu
# ("Máx" vale ao menos 60 mesmo com este valor baixo). Deixe em branco para
# usar só o esforço. Modo desenvolvedor usa AGENT_DEV_MAX_STEPS (padrão 200).
# AGENT_HARD_MAX_STEPS é o teto de UMA janela de orçamento (padrão = 1,5x o
# orçamento base). Tarefa que chega ao teto AINDA produtiva não é abortada:
# o loop compacta o histórico e renova a janela (fôlego automático), até
# AGENT_MAX_AUTO_CONTINUES vezes (padrão 6; 0 desliga e volta ao comportamento
# antigo). Os freios reais de loop continuam sendo falta de progresso: falhas
# seguidas, repetição e estagnação.
AGENT_MAX_STEPS=
AGENT_DEV_MAX_STEPS=200
AGENT_HARD_MAX_STEPS=
AGENT_MAX_AUTO_CONTINUES=6
# Pipeline multimodelo: quantas vezes uma etapa que ainda assim parar por
# limite de etapas é retomada automaticamente do checkpoint antes de virar erro.
PIPELINE_STAGE_RESUME_LIMIT=2
# Multiconversa: quantas conversas do MESMO usuário podem processar AO MESMO
# TEMPO (padrão 5). Cada execução consome provedor/RAM; conversas que executam
# código também disputam MAX_SANDBOXES_PER_USER — considere subir os dois
# juntos se usar muitas conversas paralelas com ferramentas.
MAX_ACTIVE_RUNS_PER_USER=5
# Retomada real (checkpoint): tamanho máximo do estado de execução salvo por
# conversa (JSONB no Postgres). Se um run acumular resultados de ferramenta
# muito grandes, o array é aparado mantendo o objetivo e os resultados recentes
# (piso 64000). Só mexa se ver checkpoints truncados demais ou pesados.
# CHECKPOINT_MAX_BYTES=600000
# Watchdog do streaming do modelo (contra "Raciocinando..." eterno):
# STREAM_STALL_TIMEOUT_MS — tempo máximo SEM receber nenhum dado do provedor
#   antes de abortar e retomar/cair no modelo de reserva (padrão 180000 = 3 min;
#   piso 30000). PROVIDER_CONNECT_TIMEOUT_MS — tempo máximo até o provedor
#   COMEÇAR a responder (padrão 180000; piso 30000).
# STREAM_STALL_TIMEOUT_MS=180000
# PROVIDER_CONNECT_TIMEOUT_MS=180000
# Quantas mensagens recentes da conversa são enviadas ao modelo
AGENT_HISTORY_LIMIT=60

# ---- Cache (economia de tokens, menos chamadas externas, respostas mais rápidas) ----
# Prompt caching do LLM: marca o preâmbulo estável (prompt-base, contrato de
# qualidade, notas de sistema) com cache_control para o provedor reaproveitá-lo
# entre mensagens/etapas — menos tokens de ENTRADA cobrados e menor latência.
# Ativo automaticamente APENAS via OpenRouter para as famílias que suportam
# (Anthropic/Claude e Google/Gemini). A API direta da DeepSeek já cacheia sozinha
# (não recebe cache_control). Ganho medido em usage.cached_tokens (ver /api/cache/stats).
#  - 1 (padrão): ligado.  - 0: desliga o cache_control.
# PROMPT_CACHE=1
# Cache de embeddings (vetores de busca). São determinísticos, então recomputar a
# mesma pergunta a cada mensagem é desperdício de CPU no caminho da resposta.
# Máximo de vetores guardados (cada ~1,5 KB). 0 desliga o cache. Padrão: 4000.
# EMBED_CACHE_MAX=4000
# Cache de ferramentas externas (consulta de CNPJ e busca web). 0 desliga tudo.
# TOOL_CACHE=1
# TTL do cache de CNPJ em ms (dados cadastrais mudam raramente). Padrão: 12h.
# CNPJ_CACHE_TTL_MS=43200000
# TTL do cache de busca web em ms (só corta a repetição imediata). Padrão: 10min.
# WEBSEARCH_CACHE_TTL_MS=600000

# ---- BYOK (cada usuário usa suas próprias chaves de API) ----
# Contas sem uma chave validada não recebem nenhum modelo. Cada pessoa pode
# cadastrar OpenRouter, NVIDIA, DeepSeek, Alibaba e outros endpoints compatíveis
# em Configurações → Provedores de IA; os catálogos ficam isolados por chave.

# ---- MODO GRATUITO (primeiro acesso sem chave) ----
# Com FREE_TIER_API_KEY definida, o usuário novo vê a opção "Começar
# gratuitamente": o BACKEND atende com esta chave da plataforma (ela NUNCA vai
# ao navegador/repositório), usando SÓ os modelos da allowlist abaixo, com
# limite diário por usuário, freio por minuto, fila global e painel admin
# (usuários, consumo, bloqueio por abuso) — Configurações → Modo gratuito.
# Recomendado: chave do OpenRouter usando os modelos ":free" (custo zero).
#   * Os termos do OpenRouter permitem servir seus usuários via backend próprio
#     (proibem revenda direta da API e multi-contas para burlar limites).
#   * A cota é POR CONTA (não por chave): ~50 req/dia, ou ~1.000 req/dia se a
#     conta já comprou US$ 10 em créditos alguma vez. Planeje o limite diário
#     abaixo de acordo com o número de usuários.
#   * IMPORTANTE (privacidade): muitos modelos :free exigem ativar o logging
#     nas configurações de privacidade do OpenRouter, e os prompts podem ser
#     usados para treino pelos provedores — reflita isso na sua política de
#     privacidade antes de ativar.
# FREE_TIER_API_KEY=
# FREE_TIER_BASE_URL=https://openrouter.ai/api/v1
# Nome exibido ao usuário ("qual provedor está processando"):
# FREE_TIER_PROVIDER_NAME=OpenRouter
# Modelos gratuitos, em ordem de preferência (o 1º é o padrão; os demais são a
# reserva quando o provedor devolve 429/erro). A lista :free do OpenRouter
# ROTACIONA sem aviso — confira em openrouter.ai/collections/free-models.
# FREE_TIER_MODELS=google/gemma-4-31b-it:free,openai/gpt-oss-20b:free,openrouter/free
# Limites do modo gratuito (por usuário):
# FREE_TIER_MSGS_PER_DAY=20      # mensagens/dia (admin pode mudar sem reiniciar)
# FREE_TIER_MSGS_PER_MIN=4       # freio anti-rajada
# Fila global (proteção da cota compartilhada no provedor):
# FREE_TIER_CONCURRENCY=2        # respostas gratuitas simultâneas
# FREE_TIER_QUEUE_MAX=30         # tamanho máximo da fila (0 = sem teto)
# FREE_TIER_ENABLED=true         # false desativa sem apagar a chave

# ---- Limites por usuário (proteção de recursos numa SaaS) ----
# Máximo de mensagens que cada usuário pode enviar por DIA.
#  - 0 (padrão): sem limite — bom para instância pessoal/poucos usuários.
#  - > 0: cada usuário para ao atingir o número no dia (o contador zera no dia seguinte).
# RATE_MSGS_PER_DAY=0
# Máximo de sandboxes (contêineres) ATIVOS ao mesmo tempo por usuário. Ao abrir
# um a mais, o mais antigo do próprio usuário é encerrado (padrão: 2).
# MAX_SANDBOXES_PER_USER=2
# Rate limit HTTP geral da API, por IP e por minuto (protege uploads, listagens
# e força bruta de rotas). Padrão: 600. 0 = desligado.
# RATE_API_PER_MIN=600
# Rate limit de login/cadastro (só POSTs de /api/auth), por IP a cada 15 min —
# freia força bruta de senha. Padrão: 50. 0 = desligado.
# RATE_AUTH_PER_15MIN=50

# ---- Segurança (importante num site público) ----
# E-mail do ADMINISTRADOR. Só esse usuário pode baixar o backup completo do
# sistema (banco + todos os workspaces). Sem definir, NINGUÉM pode (padrão seguro).
# ADMIN_EMAIL=voce@seudominio.com.br
# "Pastas do PC" monta caminhos do servidor no sandbox — perigoso numa VPS
# pública, então vem DESLIGADO. Só ligue em instalação pessoal/local de confiança.
# ENABLE_PC_FOLDERS=false
# Fuso horário das rotinas e dos contadores diários. Sem definir, usa
# America/Sao_Paulo (Brasil). Numa VPS o relógio do sistema costuma ser UTC.
# APP_TIMEZONE=America/Sao_Paulo

# ---- Docling (compreensão documental) ----
# Camada que processa PDFs/documentos UMA vez (layout, tabelas, OCR, ordem de
# leitura), guarda o JSON completo e envia à IA um Markdown otimizado com
# referência de página — em vez de cada modelo re-extrair o arquivo.
# DESLIGADO por padrão. Ligue só depois de subir o serviço docling-service e
# rodar a matriz de testes (veja docs/DOCLING.md).
# DOCLING_ENABLED=false
# URL interna do serviço (rede do Docker; NUNCA exposto ao público).
# DOCLING_SERVICE_URL=http://docling-service:8000
# Token compartilhado entre backend e docling-service (obrigatório em produção).
# Gere com: openssl rand -hex 32
# DOCLING_INTERNAL_TOKEN=
# Onde o backend guarda os artefatos (JSON/Markdown/chunks) do cache.
# DOCLING_CACHE_ROOT=/app/data/docling-cache
# Ajustes do serviço (opcionais): concorrência, limites e recursos.
# DOCLING_CONCURRENCY=2
# DOCLING_MAX_FILE_MB=50
# DOCLING_MAX_PAGES=600
# DOCLING_MEM_LIMIT=4g
# DOCLING_CPUS=2
# OCR: auto (padrão) | always | never — e idioma do OCR (por = português).
# DOCLING_OCR=auto
# DOCLING_OCR_LANG=por
# Limite de tokens por chunk enviado à IA.
# DOCLING_MAX_CHUNK_TOKENS=1200
# Retenção (LGPD) dos artefatos DERIVADOS (JSON/Markdown/chunks/figuras). Uma
# varredura diária apaga os derivados mais antigos que N dias — nunca o arquivo
# original (que é reprocessável). 0 = desligado. Apagar a conversa/arquivo já
# remove os derivados na hora; isto é a rede de segurança por tempo.
# DOCLING_RETENTION_DAYS=0

# ---- LGPD (privacidade) ----
# Retenção automática: apaga em DEFINITIVO conversas sem atividade há mais de
# N dias (mensagens, arquivos, memórias derivadas e workspace). 0 = desligado.
# Se ativar num site público, a regra já está descrita na página /privacidade.
# CONVERSATION_RETENTION_DAYS=0
# Retenção do REGISTRO DE CONSUMO de tokens (tabelas usage/usage_daily, que
# alimentam o painel de análises). Padrão: 365 dias. 0 = manter para sempre.
# USAGE_RETENTION_DAYS=365

# ---- Produção (VPS) — usados pelo docker-compose.prod.yml ----
# Domínio do site (o HTTPS é emitido automaticamente para ele)
# DOMAIN=app.seudominio.com.br
# (APP_PASSWORD foi removido: o acesso agora é por login de usuário — Better Auth.)

# ---- Memória de longo prazo ----
# Modelo local de embeddings (baixado uma vez para ./data/models, ~112 MB).
# EMBEDDING_MODEL=Xenova/multilingual-e5-small
# Modelo barato usado para resumir conversas e extrair fatos (padrão: o modelo principal).
# Use o id no formato do SEU provedor: OpenRouter = deepseek/deepseek-chat | DeepSeek nativo = deepseek-chat
# EXTRACT_MODEL=deepseek/deepseek-chat

# Modelo usado pela ferramenta de gerar/editar imagens (via OpenRouter).
# Outras opções: openai/gpt-image-1, black-forest-labs/flux... (catálogo do OpenRouter)
# IMAGE_MODEL=google/gemini-2.5-flash-image

# Miniatura de página (navegador headless): quando a IA abre uma página com o
# web_fetch, o backend captura um screenshot e mostra no Ambiente de Trabalho.
# Usa o Chromium do sistema (instalado na imagem Docker) via puppeteer-core.
# CHROMIUM_PATH já vem definido no Dockerfile (/usr/bin/chromium). Ajuste só se
# rodar o backend fora do Docker.
# CHROMIUM_PATH=/usr/bin/chromium
# WEB_FETCH_SCREENSHOTS=1     # 0 desliga a captura (só o texto da página)
# SCREENSHOT_TIMEOUT_MS=9000  # tempo máximo por captura (best-effort)

# Pesquisa na internet (botão de globo no chat):
# Com as duas chaves abaixo preenchidas, usa o GOOGLE (Custom Search API —
# crie em https://programmablesearchengine.google.com e https://console.cloud.google.com).
# Sem elas, usa DuckDuckGo automaticamente (não precisa de cadastro).
# GOOGLE_API_KEY=
# GOOGLE_CSE_ID=

# Rodando via docker compose, estas duas são definidas no compose e podem
# ficar como estão. Rodando o backend direto no host (npm run dev),
# ambas devem apontar para o MESMO diretório local:
WORKSPACE_ROOT=./workspaces
# HOST_WORKSPACE_ROOT=/caminho/absoluto/para/workspaces

# ---- Banco de dados (PostgreSQL) ----
# Via docker compose, o DATABASE_URL já é definido no compose (aponta para o
# serviço 'postgres') — não precisa mexer. Rodando o backend direto no host,
# suba um Postgres e aponte a URL aqui:
# DATABASE_URL=postgres://studio:studio@localhost:5432/studio

# ---- QA / robustez (todas opcionais; padrões seguros) ----
# Failover automático de modelo: se o modelo escolhido cair (erro recuperável do
# provedor), o app tenta estes modelos em ordem, sem perder o trabalho já feito.
# Se vazio, ainda cai automaticamente para o modelo-base da conta quando difere
# do escolhido. Ex.: MODEL_FALLBACKS=deepseek/deepseek-chat,meta-llama/llama-3.3-70b-instruct
# MODEL_FALLBACKS=

# Validação de arquivos gerados: recalcula .xlsx/.xlsm com o LibreOffice para
# detectar erros REAIS de fórmula (#DIV/0!, #REF! etc.). true por padrão; ponha
# false para uma validação mais rápida porém apenas parcial (lint das fórmulas).
# VALIDATE_RECALC=true
# SANDBOX_RECALC_TIMEOUT_S=25   # tempo máximo do recálculo por arquivo
# RECALC_MAX_FILES=2            # quantos arquivos recalcular por resposta
# VALIDATE_MAX_CELLS=40000      # teto de células varridas (evita travar em planilhas enormes)
# VALIDATE_TIMEOUT_MS=60000     # tempo máximo total da validação

# Coleta de lixo de disco (soak/uso público): remove arquivos de saída mais
# antigos que N dias. 0 = desligado (não apaga entregas do usuário).
# OUTPUT_RETENTION_DAYS=0
# DISK_SWEEP_INTERVAL_MS=1800000

# Conector GitHub (Configurações → Conectores): tempos máximos das operações
# git que rodam no backend. Os padrões atendem repositórios comuns; aumente o
# de clone para repositórios muito grandes.
# GITHUB_CLONE_TIMEOUT_MS=300000
# GITHUB_GIT_TIMEOUT_MS=120000

# Modo Equipe: tamanho do histórico e do briefing entregues aos especialistas.
# TEAM_HISTORY_MSGS=21
# TEAM_HISTORY_CHARS=1600
# TEAM_PERSPECTIVE_CHARS=6000
# TEAM_BRIEFING_CHARS=20000
# TEAM_MEMBER_CONTINUATIONS=2   # quantas vezes continuar um parecer truncado
